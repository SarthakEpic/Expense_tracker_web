APP_USERNAME=admin
APP_PASSWORD_HASH=pbkdf2_sha256$120000$replace_with_create_user_output
SECRET_KEY=replace_with_a_long_random_secret

# Optional. Unset = local SQLite (expenses.db). Set = Postgres (cloud deployments).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional. Timezone for transaction timestamps (cloud servers default to UTC).
# TZ=Asia/Kolkata
